# 값이 없으면 앱은 샘플 모드로 동작합니다 (저장 안 됨).
# 실제 값은 Vercel 환경 변수 또는 .env.local에만 넣고 저장소에 올리지 마세요. 순서는 SETUP.md 참고.

# 4단계: Supabase (무료 플랜)
NEXT_PUBLIC_SUPABASE_URL=                 # https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_... (예전 이름: anon key — NEXT_PUBLIC_SUPABASE_ANON_KEY도 인식)
ALLOWED_EMAILS=                           # 로그인 허용 이메일, 여러 개면 쉼표로

# 5단계: YouTube (Google OAuth) — 아직 사용 안 함
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                     # 서버 전용
TOKEN_ENCRYPTION_KEY=                     # 갱신 토큰 암호화용 32바이트 키(base64). 서버 전용

# 6단계: AI 인사이트 — 아직 사용 안 함
ANTHROPIC_API_KEY=                        # 서버 전용
